# Copy this file to .env and fill in your values.
# Required only for the providers you use.

# --- API Keys (optional if using OLLAMA only) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=   # optional; can also be set per-session in the web UI

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Sampling (all providers) ---
# Temperature 0 and a fixed seed keep runs comparable across prompt versions.
# Leave empty to use the provider default (some reasoning models only accept 1).
# LLM_TEMPERATURE=0
# LLM_SEED=42

# --- Flask ---
FLASK_SECRET_KEY=change-me-in-production
# PORT=5000
# HOST=127.0.0.1
# FLASK_DEBUG=False

# --- RAG (Chroma) ---
# RAG_CHROMA_HOST=localhost
# RAG_CHROMA_PORT=8000
# RAG_CHROMA_SSL=false
# RAG_COLLECTION_NAME=nist_controls_summarized
# RAG_EMBEDDING_PROVIDER=OLLAMA
# RAG_EMBEDDING_MODEL=qwen3-embedding:4b

# --- Paths ---
# BLOCKS_DIR=./blocks

# --- Paid mode (web UI buttons "Run with the paid models / judge") ---
# The key stays on the server, so it never has to be typed into the screen.
# Analyst and judge are different models, so no model grades its own threats.
# PAID_PROVIDER=OPENAI                  # OpenAI-compatible, e.g. OpenRouter via OPENAI_BASE_URL
# PAID_API_KEY=                         # falls back to OPENAI_API_KEY
# PAID_ANALYST_MODEL=openai/gpt-5
# PAID_JUDGE_MODEL=google/gemini-2.5-flash
